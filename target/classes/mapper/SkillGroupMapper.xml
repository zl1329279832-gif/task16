<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.customerservice.mapper.SkillGroupMapper">

    <resultMap id="skillGroupMap" type="com.customerservice.model.entity.SkillGroup">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectById" resultMap="skillGroupMap">
        SELECT * FROM cs_skill_group WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="skillGroupMap">
        SELECT * FROM cs_skill_group WHERE name = #{name}
    </select>

    <select id="selectAll" resultMap="skillGroupMap">
        SELECT * FROM cs_skill_group ORDER BY id
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cs_skill_group (name, description) VALUES (#{name}, #{description})
    </insert>
</mapper>
