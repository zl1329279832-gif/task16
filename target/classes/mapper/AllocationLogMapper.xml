<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.customerservice.mapper.AllocationLogMapper">

    <resultMap id="allocationLogMap" type="com.customerservice.model.entity.AllocationLog">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="from_agent_id" property="fromAgentId"/>
        <result column="to_agent_id" property="toAgentId"/>
        <result column="action" property="action"/>
        <result column="reason" property="reason"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cs_allocation_log (session_id, from_agent_id, to_agent_id, action, reason)
        VALUES (#{sessionId}, #{fromAgentId}, #{toAgentId}, #{action}, #{reason})
    </insert>

    <select id="selectBySessionId" resultMap="allocationLogMap">
        SELECT * FROM cs_allocation_log WHERE session_id = #{sessionId} ORDER BY created_at ASC
    </select>
</mapper>
